{
  "functions": {
    "api/**/*.php": { "runtime": "vercel-php@0.7.1" },
    "index.php": { "runtime": "vercel-php@0.7.1" },
    "customer.php": { "runtime": "vercel-php@0.7.1" },
    "settings.php": { "runtime": "vercel-php@0.7.1" }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/customer", "dest": "/customer.php" },
    { "src": "/settings", "dest": "/settings.php" },
    { "src": "/", "dest": "/index.php" }
  ]
}
